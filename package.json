{
  "name": "vancouver-event-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "import:ticketmaster": "node --env-file=.env.local scripts/importTicketmasterEvents.js",
    "normalize:ticketmaster": "node --env-file=.env.local scripts/normalizeTicketmasterRawEvents.js",
    "cleanup:events": "node --env-file=.env.local scripts/cleanupExpiredEvents.js",
    "cleanup:events:dry": "node --env-file=.env.local scripts/cleanupExpiredEvents.js --dry-run",
    "import:ubc": "node --env-file=.env.local scripts/importUbcEvents.js",
    "import:ubc:dry": "node --env-file=.env.local scripts/importUbcEvents.js --dry-run",
    "normalize:ubc": "node --env-file=.env.local scripts/normalizeUbcRawEvents.js",
    "normalize:ubc:dry": "node --env-file=.env.local scripts/normalizeUbcRawEvents.js --dry-run",
    "import:blueprint": "node --env-file=.env.local scripts/importBlueprintEvents.js",
    "import:blueprint:dry": "node --env-file=.env.local scripts/importBlueprintEvents.js --dry-run"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.105.4",
    "dotenv": "^17.4.2",
    "leaflet": "^1.9.4",
    "maplibre-gl": "^5.24.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-leaflet": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.2.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "tailwindcss": "^4.2.4",
    "vite": "^8.0.10"
  }
